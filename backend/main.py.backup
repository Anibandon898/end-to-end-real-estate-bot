# =========================================================
# CHAT REQUEST
# =========================================================

class ChatRequest(BaseModel):
    session_id: str
    message: str


# =========================================================
# LEAD REQUEST
# =========================================================

class LeadRequest(BaseModel):
    session_id: Optional[str] = None
    name: Optional[str] = None
    email: Optional[EmailStr] = None
    phone: Optional[str] = None
    location: Optional[str] = None
    property_type: Optional[str] = None
    purpose: Optional[str] = None
    budget: Optional[float] = None
    budget_text: Optional[str] = None
    bedrooms: Optional[int] = None
    timeline: Optional[str] = None
    message: Optional[str] = None
    lead_quality: Optional[str] = None
    main_problem: Optional[str] = None
    recommended_action: Optional[str] = None
    source: str = "real-estate-chatbot"
    property_images: List[str] = Field(default_factory=list)


# =========================================================
# CHAT ENDPOINT
# =========================================================

@app.post("/api/v1/chat")
def chat(request: ChatRequest):

    session_id = request.session_id.strip()

    user_message = normalize_text(request.message)

    if not session_id:
        session_id = str(uuid.uuid4())

    if not user_message:
        return {
            "success": False,
            "session_id": session_id,
            "reply": "Please tell me what type of property you are looking for.",
        }

    if session_id not in sessions:
        create_session(session_id)

    session = sessions[session_id]

    # Extract everything from this message.
    update_session_from_message(
        session,
        user_message,
    )

    # Determine what is still missing.
    missing_field = next_missing_field(session)

    # -----------------------------------------------------
    # COMPLETE LEAD
    # -----------------------------------------------------

    if missing_field is None:

        session["lead_quality"] = calculate_lead_quality(
            session
        )

        # Send to n8n only once.
        n8n_result = {
            "sent": session.get("n8n_sent", False)
        }

        if not session.get("n8n_sent"):

            n8n_result = send_to_n8n(session)

            if n8n_result.get("sent"):
                session["n8n_sent"] = True

        # Save to Supabase only once.
        supabase_result = {
            "saved": session.get("supabase_saved", False)
        }

        if not session.get("supabase_saved"):

            supabase_result = save_to_supabase(session)

            if supabase_result.get("saved"):
                session["supabase_saved"] = True

        return {
            "success": True,
            "session_id": session_id,
            "reply": (
                "Perfect! I have everything I need. "
                "Our property team can now review your "
                "requirements and get back to you with "
                "suitable options."
            ),
            "lead_quality": session["lead_quality"],
            "missing_field": None,
            "complete": True,
            "lead": session,
            "integrations": {
                "n8n": n8n_result,
                "supabase": supabase_result,
            },
        }

    # -----------------------------------------------------
    # CONTINUE CONVERSATION
    # -----------------------------------------------------

    return {
        "success": True,
        "session_id": session_id,
        "reply": question_for_field(missing_field),
        "lead_quality": session["lead_quality"],
        "missing_field": missing_field,
        "complete": False,
        "lead": session,
        "integrations": {
            "n8n": {
                "sent": session.get("n8n_sent", False)
            },
            "supabase": {
                "saved": session.get(
                    "supabase_saved",
                    False,
                )
            },
        },
    }


# =========================================================
# MANUAL LEAD ENDPOINT
# =========================================================

@app.post("/api/v1/leads")
def create_lead(request: LeadRequest):

    lead = request.model_dump()

    if not lead.get("session_id"):
        lead["session_id"] = str(uuid.uuid4())

    if not lead.get("lead_quality"):
        lead["lead_quality"] = calculate_lead_quality(
            lead
        )

    n8n_result = send_to_n8n(lead)

    supabase_result = save_to_supabase(lead)

    return {
        "success": True,
        "message": "Lead processed",
        "lead": lead,
        "integrations": {
            "n8n": n8n_result,
            "supabase": supabase_result,
        },
    }


# =========================================================
# IMAGE UPLOAD
# =========================================================

@app.post("/api/v1/upload")
async def upload_image(
    file: UploadFile = File(...),
):

    allowed_types = {
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/gif",
    }

    if file.content_type not in allowed_types:
        return {
            "success": False,
            "error": (
                "Unsupported image type. "
                "Please upload JPG, PNG, WEBP, or GIF."
            ),
        }

    # 8 MB maximum.
    max_size = 8 * 1024 * 1024

    contents = await file.read()

    if len(contents) > max_size:
        return {
            "success": False,
            "error": "Image is larger than 8MB.",
        }

    if not SUPABASE_URL or not SUPABASE_KEY:
        return {
            "success": False,
            "error": "Supabase is not configured.",
        }

    original_name = file.filename or "property-image"

    extension = os.path.splitext(
        original_name
    )[1].lower()

    if not extension:
        extension = ".jpg"

    filename = (
        f"{uuid.uuid4().hex}"
        f"{extension}"
    )

    storage_url = (
        f"{SUPABASE_URL}/storage/v1/object/"
        f"{SUPABASE_BUCKET}/{filename}"
    )

    headers = {
        "apikey": SUPABASE_KEY,
        "Authorization": f"Bearer {SUPABASE_KEY}",
        "Content-Type": file.content_type,
        "x-upsert": "false",
    }

    try:

        response = requests.post(
            storage_url,
            headers=headers,
            data=contents,
            timeout=30,
        )

        if not response.ok:

            return {
                "success": False,
                "status": response.status_code,
                "error": response.text[:1000],
            }

        public_url = (
            f"{SUPABASE_URL}/storage/v1/object/public/"
            f"{SUPABASE_BUCKET}/{filename}"
        )

        return {
            "success": True,
            "filename": filename,
            "url": public_url,
            "message": "Property image uploaded successfully.",
        }

    except Exception as exc:

        return {
            "success": False,
            "error": str(exc),
        }


# =========================================================
# GET SESSION
# =========================================================

@app.get("/api/v1/sessions/{session_id}")
def get_session(session_id: str):

    session = sessions.get(session_id)

    if not session:
        return {
            "success": False,
            "message": "Session not found",
        }

    return {
        "success": True,
        "session": session,
    }


# =========================================================
# DELETE SESSION
# =========================================================

@app.delete("/api/v1/sessions/{session_id}")
def delete_session(session_id: str):

    if session_id in sessions:
        del sessions[session_id]

    return {
        "success": True,
        "message": "Session cleared",
    }